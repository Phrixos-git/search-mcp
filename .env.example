SEARXNG_BASE_URL=http://searxng:8080
MEILISEARCH_URL=http://meilisearch:7700
SQLITE_DB_PATH=/data/search.db

MCP_HOST=0.0.0.0
MCP_PORT=8081
# Optional Linux host-network Nginx proxy (docker compose --profile proxy).
NGINX_PORT=38083
LOG_LEVEL=info
# Replace with a random secret value in your ignored local .env file.
SEARXNG_SECRET=

SQLITE_BUSY_TIMEOUT_MS=5000
SEARXNG_TIMEOUT_MS=18000
FETCH_TIMEOUT_MS=18000
FETCH_MAX_RESPONSE_BYTES=5242880
CACHE_FALLBACK_TTL=24h
MEILI_TASK_POLL_INTERVAL=1s
MEILI_TASK_WATCH_TIMEOUT=30s
SNIPPET_MAX_CHARS=256

# Docker Compose Secret path; do not put the secret value in this file.
MEILI_MASTER_KEY_FILE=/run/secrets/meili_master_key
